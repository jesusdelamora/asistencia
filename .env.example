# Contraseña del panel de administración (/admin)
ADMIN_PASSWORD=cambiame
# Secreto para firmar la sesión del admin (cualquier cadena larga aleatoria)
SESSION_SECRET=
# Zona horaria usada para validar los horarios de clase
APP_TZ=America/Mexico_City

# Base de datos Turso (en Vercel las inyecta la integración del Marketplace)
# En local, si se dejan vacías, se usa el archivo data/asistencia.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Solo local
PORT=3000
